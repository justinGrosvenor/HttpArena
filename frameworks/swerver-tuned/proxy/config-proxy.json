{
  "server": {
    "address": "0.0.0.0",
    "port": 8443,
    "workers": 0,
    "max_connections": 512
  },
  "timeouts": {
    "idle_ms": 30000,
    "header_ms": 5000,
    "body_ms": 10000
  },
  "buffer_pool": {
    "buffer_size": 65536,
    "buffer_count": 1024
  },
  "tls": {
    "cert_path": "/certs/server.crt",
    "key_path": "/certs/server.key"
  },
  "http2": {
    "max_streams": 256,
    "initial_window_size": 1048576
  },
  "quic": {
    "enabled": true,
    "port": 8443,
    "cert_path": "/certs/server.crt",
    "key_path": "/certs/server.key",
    "max_idle_timeout_ms": 30000,
    "max_streams_bidi": 256,
    "max_streams_uni": 16
  },
  "upstreams": [
    {
      "name": "backend",
      "servers": [
        { "address": "127.0.0.1", "port": 8090 }
      ],
      "load_balancer": "round_robin"
    }
  ],
  "routes": [
    {
      "path_prefix": "/",
      "upstream": "backend",
      "retry": { "max_retries": 6 }
    }
  ]
}
